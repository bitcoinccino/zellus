<%# Payment request page — kept to what the payer needs: who's asking, how
    much, what for, and Peye / Refize. Everything else was trimmed (status
    badge, separate currency pill, duplicate amount summary, Ref, etc.). %>
<div class="container d-flex justify-content-center" style="min-height: 80vh; padding-top: 16px;">
  <div class="w-100" style="max-width: 440px; min-width: 0;">

    <% pr = @payment_request %>
    <% creator = pr.user %>
    <% creator_name = creator.display_name %>
    <% creator_initial = (creator.cashtag.presence || creator_name).to_s.delete("$").strip.chars.first&.upcase || "?" %>
    <% asset_label = pr.usd? ? "USD" : pr.asset.upcase %>
    <% fmt = ->(n) { number_with_precision(n, precision: 2, delimiter: ",") } %>
    <% amount_label = "#{fmt.(pr.amount)} #{asset_label}" %>

    <div class="rounded-4" style="background: var(--haiti-cream); overflow: hidden;">

      <%# ── Top: who, how much, what for ── %>
      <div class="p-4 text-center" style="background: var(--haiti-charcoal);">
        <div class="d-flex justify-content-center mb-2">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
               style="width: 56px; height: 56px; background: rgba(255,255,255,0.08); border: 2px solid var(--haiti-gold); overflow: hidden;">
            <% if creator.avatar.attached? %>
              <%= image_tag creator.avatar, style: "width: 100%; height: 100%; object-fit: cover;", alt: "" %>
            <% else %>
              <span class="fw-black" style="color: var(--haiti-gold); font-size: 20px;"><%= creator_initial %></span>
            <% end %>
          </div>
        </div>

        <div class="fw-bold" style="color: white; font-size: 15px;">
          <%= creator_name %> <span style="color: rgba(255,255,255,0.5); font-weight: 500;">mande ou</span>
        </div>

        <div class="fw-black mt-2 text-break" style="font-size: 38px; letter-spacing: -1px; line-height: 1.1;
             color: <%= pr.active? ? 'var(--haiti-gold)' : 'rgba(255,255,255,0.25)' %>;
             <%= 'text-decoration: line-through;' unless pr.active? %>">
          <%= fmt.(pr.amount) %> <span style="font-size: 16px; letter-spacing: 0; color: rgba(255,255,255,0.5);"><%= asset_label %></span>
        </div>

        <% if pr.note.present? %>
          <div class="mt-2 text-break" style="color: rgba(255,255,255,0.7); font-size: 13px;"><%= pr.note %></div>
        <% end %>

        <% if pr.active? && (time_left = pr.expires_in_time) %>
          <div class="mt-2" style="font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.4);">
            <i class="ri-timer-line me-1"></i>Ekspire nan
            <span style="color: <%= pr.expires_soon? ? '#fbbf24' : '#22c55e' %>;"><%= time_left %></span>
          </div>
        <% end %>
      </div>

      <%# ── Bottom: what you can do ── %>
      <div class="p-4">

        <% if !pr.active? %>

          <% done_cfg =
               if pr.paid?        then { icon: "ri-checkbox-circle-fill", color: "#22c55e", text: "Demann sa a deja peye" }
               elsif pr.expired?  then { icon: "ri-time-line",            color: "#f87171", text: "Demann sa a ekspire" }
               elsif pr.declined? then { icon: "ri-close-circle-line",    color: "#f87171", text: "Demann sa a refize" }
               else                    { icon: "ri-close-circle-line",    color: "#f87171", text: "Demann sa a anile" }
               end %>
          <div class="text-center py-2">
            <i class="<%= done_cfg[:icon] %> d-block mb-2" style="color: <%= done_cfg[:color] %>; font-size: 28px;"></i>
            <div class="fw-bold" style="color: var(--haiti-charcoal); font-size: 14px;"><%= done_cfg[:text] %></div>
            <% if pr.declined? && pr.cancel_note.present? %>
              <div class="small mt-2 text-break" style="color: var(--haiti-olive);">“<%= pr.cancel_note %>”</div>
            <% end %>
          </div>

        <% elsif current_user.blank? %>

          <%= link_to new_user_session_path,
              class: "btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2",
              style: "background: var(--haiti-charcoal); color: var(--haiti-gold); font-size: 14px;" do %>
            <i class="ri-login-box-line" style="font-size: 18px;"></i> Konekte pou peye
          <% end %>

        <% elsif @is_creator %>

          <div class="text-center small py-2" style="color: var(--haiti-olive);">
            Sa a se demann ou. Pataje lyen an ak moun ki dwe peye a.
          </div>

        <% else %>

          <%# Everything the payer can do lives in #pr-main; Refize swaps it
              for #pr-decline so the two never show at the same time. %>
          <div id="pr-main">

            <% if %w[eth wbtc].include?(pr.asset) %>

              <%= link_to wallet_path(action_panel: "convert"),
                  class: "btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2",
                  style: "background: var(--haiti-gold); color: var(--haiti-charcoal); font-size: 14px;" do %>
                <i class="ri-exchange-2-line" style="font-size: 18px;"></i> Konvèti epi peye
              <% end %>

            <% elsif !@pin_set %>

              <div class="text-center small mb-2" style="color: var(--haiti-olive);">Kreye yon PIN 4 chif pou peye.</div>
              <%= form_with url: set_pin_payment_request_path(pr.token), method: :post, local: true do %>
                <input type="password" name="transfer_pin" maxlength="4" pattern="\d{4}" inputmode="numeric"
                       class="form-control text-center fw-bold rounded-3 mb-3"
                       style="font-size: 24px; letter-spacing: 8px; padding: 12px; border: 2px solid rgba(93,99,69,0.2); background: rgba(93,99,69,0.04);"
                       placeholder="····" required autocomplete="off" aria-label="Nouvo PIN">
                <button type="submit"
                        class="btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2"
                        style="background: var(--haiti-charcoal); color: var(--haiti-gold); font-size: 14px;">
                  <i class="ri-lock-line" style="font-size: 18px;"></i> Kreye PIN
                </button>
              <% end %>

            <% elsif @can_pay_direct %>

              <%# Step 1 — Peye %>
              <div id="pr-pay-summary">
                <div class="text-center small mb-3" style="color: var(--haiti-olive);">
                  <i class="ri-wallet-3-line me-1" style="color: var(--haiti-gold);"></i>Balans: <span class="fw-bold" style="color: var(--haiti-charcoal);"><%= fmt.(@payer_balance) %> <%= asset_label %></span>
                </div>
                <button type="button" onclick="showPayPin()"
                        class="btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2"
                        style="background: var(--haiti-gold); color: var(--haiti-charcoal); font-size: 14px;">
                  <i class="ri-send-plane-fill" style="font-size: 18px;"></i> Peye <%= amount_label %>
                </button>
              </div>

              <%# Step 2 — PIN %>
              <div id="pr-pay-pin" style="display: none;">
                <%= form_with url: pay_payment_request_path(pr.token), method: :post, local: true do %>
                  <div class="text-center small fw-bold mb-2" style="color: var(--haiti-olive);">Antre PIN ou</div>
                  <input type="password" name="transfer_pin" id="pr-pay-pin-input" maxlength="4" pattern="\d{4}" inputmode="numeric"
                         class="form-control text-center fw-bold rounded-3 mb-3"
                         style="font-size: 24px; letter-spacing: 8px; padding: 12px; border: 2px solid rgba(93,99,69,0.2); background: rgba(93,99,69,0.04);"
                         placeholder="····" required autocomplete="off" disabled aria-label="PIN">
                  <button type="submit"
                          class="btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2"
                          style="background: var(--haiti-gold); color: var(--haiti-charcoal); font-size: 14px;">
                    <i class="ri-send-plane-fill" style="font-size: 18px;"></i> Konfime peman
                  </button>
                  <div class="text-center mt-3">
                    <a href="#" onclick="hidePayPin(); return false;" class="small fw-bold" style="color: var(--haiti-olive); text-decoration: none;">
                      <i class="ri-arrow-left-line me-1"></i>Retounen
                    </a>
                  </div>
                <% end %>
              </div>

            <% else %>

              <%# Not enough balance %>
              <div class="text-center small mb-3" style="color: var(--haiti-olive);">
                <i class="ri-wallet-3-line me-1" style="color: var(--haiti-gold);"></i>Balans: <span class="fw-bold" style="color: var(--haiti-charcoal);"><%= fmt.(@payer_balance) %> <%= asset_label %></span>
              </div>
              <% if pr.htg? %>
                <%= link_to wallet_path(action_panel: "deposit"),
                    class: "btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2",
                    style: "background: var(--haiti-charcoal); color: var(--haiti-gold); font-size: 14px;" do %>
                  <i class="ri-add-circle-line" style="font-size: 18px;"></i> Depoze HTG
                <% end %>
              <% else %>
                <%= link_to wallet_path(action_panel: "convert"),
                    class: "btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2",
                    style: "background: var(--haiti-charcoal); color: var(--haiti-gold); font-size: 14px;" do %>
                  <i class="ri-exchange-2-line" style="font-size: 18px;"></i> Konvèti HTG → <%= asset_label %>
                <% end %>
              <% end %>

            <% end %>

            <%# Refize — available in every payer state %>
            <div class="text-center mt-3">
              <a href="#" onclick="showDeclinePanel(); return false;" class="small fw-bold" style="color: #dc2626; text-decoration: none;">
                <i class="ri-close-circle-line me-1"></i>Refize
              </a>
            </div>
          </div>

          <%# Decline — replaces #pr-main while open %>
          <div id="pr-decline" style="display: none;">
            <%= form_with url: decline_payment_request_path(pr.token), method: :post, local: true do %>
              <div class="text-center mb-3">
                <div class="fw-bold" style="color: var(--haiti-charcoal); font-size: 14px;">Refize demann sa a?</div>
                <div class="small mt-1" style="color: var(--haiti-olive);"><%= creator_name %> ap resevwa yon notifikasyon.</div>
              </div>
              <textarea name="decline_note" rows="2"
                        class="form-control rounded-3 mb-3"
                        style="font-size: 13px; resize: none; border: 2px solid rgba(93,99,69,0.2); background: rgba(93,99,69,0.04);"
                        placeholder="Rezon (opsyonèl)" aria-label="Rezon"></textarea>
              <button type="submit"
                      class="btn w-100 py-3 fw-bold rounded-4 border-0 d-flex align-items-center justify-content-center gap-2"
                      style="background: #dc2626; color: white; font-size: 14px;">
                <i class="ri-close-circle-line" style="font-size: 18px;"></i> Wi, refize
              </button>
              <div class="text-center mt-3">
                <a href="#" onclick="hideDeclinePanel(); return false;" class="small fw-bold" style="color: var(--haiti-olive); text-decoration: none;">
                  <i class="ri-arrow-left-line me-1"></i>Retounen
                </a>
              </div>
            <% end %>
          </div>

        <% end %>

      </div>
    </div>

  </div>
</div>

<script>
function showPayPin() {
  document.getElementById('pr-pay-summary').style.display = 'none';
  document.getElementById('pr-pay-pin').style.display = '';
  var input = document.getElementById('pr-pay-pin-input');
  if (input) { input.disabled = false; input.focus(); }
}

function hidePayPin() {
  document.getElementById('pr-pay-pin').style.display = 'none';
  document.getElementById('pr-pay-summary').style.display = '';
  var input = document.getElementById('pr-pay-pin-input');
  if (input) { input.disabled = true; input.value = ''; }
}

function showDeclinePanel() {
  if (document.getElementById('pr-pay-pin')) hidePayPin();
  document.getElementById('pr-main').style.display = 'none';
  document.getElementById('pr-decline').style.display = '';
}

function hideDeclinePanel() {
  document.getElementById('pr-decline').style.display = 'none';
  document.getElementById('pr-main').style.display = '';
}
</script>
