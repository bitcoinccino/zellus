<%
  # Reasons to verify, built from the live limits so the page can't drift from
  # what the code actually enforces (WalletLimitService / BonIdService).
  limit_cfg          = WalletLimitService.config
  multiplier         = limit_cfg[:verified_multiplier].to_d
  multiplier_label   = multiplier.frac.zero? ? multiplier.to_i : multiplier.round(1)
  withdraw_threshold = number_with_delimiter(limit_cfg[:bonid_withdrawal_threshold_htg].to_i, delimiter: " ")
  consent_threshold  = number_with_delimiter(BonIdService::CONSENT_THRESHOLD.to_i, delimiter: " ")

  verify_reasons = [
    {
      group: "Pi gwo limit",
      items: [
        { icon: "ri-arrow-up-double-line",
          title: "Limit #{multiplier_label}× pi wo",
          text: "Achte, konvèti ak retire #{multiplier_label} fwa plis chak jou." },
        { icon: "ri-bank-line",
          title: "Retire #{withdraw_threshold} HTG oswa plis",
          text: "San BonID, retrè yo rete anba #{withdraw_threshold} HTG chak 24 èdtan." }
      ]
    },
    {
      group: "Pwoteksyon kont fwod",
      items: [
        { icon: "ri-shield-keyhole-line",
          title: "Ou apwouve gwo transfè yo",
          text: "Chak transfè #{consent_threshold} HTG oswa plis mande pou w apwouve l sou BonID, menm si yon moun konnen PIN ou." },
        { icon: "ri-user-follow-line",
          title: "Kont ou mare ak vrè idantite w",
          text: "Sa fè li pi difisil pou yon moun pran non w oswa itilize kont ou nan plas ou." }
      ]
    }
  ]
  verified = current_user.bonid_verified?
%>

<style>
  .verify-reason {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 12px 14px; margin-bottom: 8px; border-radius: 12px;
    background: var(--haiti-mint); border: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .verify-reason:hover { border-color: rgba(0, 32, 159, 0.25); }
  .verify-reason .bonid-verified-icon { width: 32px; height: 32px; box-shadow: none; }
  .verify-reason .bonid-verified-icon i { font-size: 16px; }
  .verify-reason-title { color: var(--haiti-charcoal); font-size: 13px; font-weight: 700; line-height: 1.3; }
  .verify-reason-text  { color: rgba(46, 46, 56, 0.65); font-size: 12px; line-height: 1.45; margin-top: 2px; }
  .verify-reason-status { margin-left: auto; flex-shrink: 0; font-size: 18px; line-height: 1; padding-top: 6px; }
  .verify-group-label {
    font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;
    color: var(--haiti-olive); margin: 14px 0 8px;
  }
</style>

<div class="container py-4" style="max-width: 480px;">
  <div class="card-base p-4 w-100" style="border: 1px solid rgba(46,46,56,0.05);">

    <%# ── Page Header ── %>
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h1 class="h5 fw-black mb-0" style="color: var(--haiti-charcoal); font-family: 'Space Grotesk', sans-serif;">Verifye ak BonID</h1>
      <%= link_to root_path, class: "small text-decoration-none fw-bold", style: "color: var(--haiti-olive);" do %>
        <i class="ri-arrow-left-line me-1"></i>Lakay
      <% end %>
    </div>

    <% if verified %>
      <%# ══════════════════════════════════════ %>
      <%# ── VERIFIED STATE                 ──  %>
      <%# ══════════════════════════════════════ %>
      <div class="p-5 rounded-4 mb-4 text-center" style="background: var(--haiti-charcoal);">
        <div class="d-inline-block position-relative mb-3">
          <% if current_user.bonid_photo_url.present? %>
            <img src="<%= current_user.bonid_photo_url %>" alt="Foto" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover; border: 3px solid var(--haiti-gold);">
            <span class="bonid-verified-badge" title="Idantite verifye ak BonID" aria-hidden="true"><i class="ri-check-line"></i></span>
          <% else %>
            <div class="bonid-verified-icon bonid-verified-icon--lg" aria-hidden="true"><i class="ri-shield-check-fill"></i></div>
          <% end %>
        </div>
        <div class="fw-bold text-uppercase mb-1" style="color: rgba(255,255,255,0.45); font-size: 11px; letter-spacing: 1.5px;">Verifye</div>
        <div class="fw-black" style="color: #fff; font-size: 22px; line-height: 1.2; font-family: 'Space Grotesk', sans-serif;">
          <%= current_user.bonid_full_name || current_user.display_name %>
        </div>
        <div style="border-top: 1px solid rgba(255,255,255,0.10); margin: 10px auto; width: 60%;"></div>
        <div style="color: var(--haiti-gold); font-size: 13px; font-weight: 700;">
          <i class="ri-fingerprint-line me-1"></i><span title="Nimewo BonID ou (kache pou sekirite)"><%= masked_bonid(current_user.bonid) %></span>
        </div>
        <div class="mt-2" style="color: rgba(255,255,255,0.35); font-size: 11px;">
          Verifye <%= current_user.bonid_verified_at.strftime("%d %b %Y") %>
        </div>
      </div>

      <div class="small fw-bold mb-1" style="color: var(--haiti-charcoal); font-size: 14px;">Sa verifikasyon an ba ou</div>
      <div style="color: rgba(46,46,56,0.6); font-size: 12px;">Tout avantaj sa yo aktive sou kont ou.</div>

    <% else %>
      <%# ══════════════════════════════════════ %>
      <%# ── UNVERIFIED STATE               ──  %>
      <%# ══════════════════════════════════════ %>
      <div class="p-4 rounded-4 mb-4 text-center" style="background: var(--haiti-charcoal);">
        <div class="d-inline-flex mb-3">
          <div class="bonid-verified-icon bonid-verified-icon--lg" style="width: 72px; height: 72px;" aria-hidden="true"><i class="ri-shield-check-fill"></i></div>
        </div>
        <div class="fw-black mb-2" style="color: #fff; font-size: 16px; font-family: 'Space Grotesk', sans-serif;">Kisa BonID ye?</div>
        <div style="color: rgba(255,255,255,0.6); font-size: 12px; max-width: 320px; margin: 0 auto; line-height: 1.6;">
          <strong style="color: var(--haiti-gold);">BonID</strong> se yon idantite dijital prive an Ayiti. Li pèmèt ou verifye tèt ou
          <strong style="color: rgba(255,255,255,0.8);">yon sèl fwa</strong> san ale nan okenn biwo, san voye imèl, san tann SMS.
        </div>
        <div style="margin: 12px auto; border-top: 1px solid rgba(255,255,255,0.08); width: 60%;"></div>
        <div style="color: rgba(255,255,255,0.4); font-size: 11px;">
          <i class="ri-time-line me-1"></i>Verifye nan mwens pase 2 minit
        </div>
      </div>

      <div class="small fw-bold mb-1" style="color: var(--haiti-charcoal); font-size: 14px;">Poukisa pou w verifye?</div>
      <div style="color: rgba(46,46,56,0.6); font-size: 12px;">Men sa w ap debloke lè w verifye ak BonID.</div>
    <% end %>

    <%# ── Reasons to verify (shared by both states) ── %>
    <div class="mb-4">
      <% verify_reasons.each do |section| %>
        <div class="verify-group-label"><%= section[:group] %></div>
        <% section[:items].each do |item| %>
          <div class="verify-reason">
            <div class="bonid-verified-icon" aria-hidden="true"><i class="<%= item[:icon] %>"></i></div>
            <div style="min-width: 0;">
              <div class="verify-reason-title"><%= item[:title] %></div>
              <div class="verify-reason-text"><%= item[:text] %></div>
            </div>
            <% if verified %>
              <i class="ri-checkbox-circle-fill verify-reason-status" style="color: #166534;" title="Aktive" aria-label="Aktive"></i>
            <% else %>
              <i class="ri-lock-2-line verify-reason-status" style="color: rgba(46,46,56,0.35);" title="Bloke" aria-label="Bloke jiskaske w verifye"></i>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% unless verified %>
      <%# ── BonID Connect Button (Gold Primary) ── %>
      <%= link_to "#{BonIdService.web_url}/citizens/otp_sign_in?from_partner=zellus&lang=ht", id: "bonid-connect-btn", class: "btn w-100 rounded-pill py-3 mb-3 fw-black d-flex align-items-center justify-content-center gap-2", style: "background: var(--haiti-gold); color: var(--haiti-charcoal); font-family: 'Space Grotesk', sans-serif; font-size: 15px; border: none;" do %>
        <i class="ri-shield-check-fill" style="font-size: 20px;"></i>Konekte ak BonID
      <% end %>

      <%= render "shared/step_loader", id: "bonid-loader", steps: [
        "N ap voye'w sou BonID...",
        "Pou'w ka verifye tèt ou."
      ] %>

      <script>
        document.getElementById('bonid-connect-btn').addEventListener('click', function(e) {
          e.preventDefault();
          var url = this.href;
          ZellusLoader.start('bonid-loader', null, { stepDelay: 2500 });
          setTimeout(function() { window.location.href = url; }, 5500);
        });
      </script>

      <div class="text-center mb-3" style="font-size: 12px;">
        <span style="color: var(--haiti-olive);">Pa gen BonID?</span>
        <%= link_to "#{BonIdService.web_url}/citizens/sign_up?lang=ht&partner=zellus", target: "_blank", rel: "noopener", style: "color: var(--haiti-gold); font-weight: 700; text-decoration: none;" do %>
          Kreye youn <i class="ri-external-link-line" style="font-size: 11px;"></i>
        <% end %>
      </div>

      <div class="text-center" style="color: var(--haiti-olive); font-size: 11px;">
        <i class="ri-lock-line me-1"></i>Done ou yo pwoteje epi an sekirite.
      </div>
    <% end %>

  </div>
</div>
